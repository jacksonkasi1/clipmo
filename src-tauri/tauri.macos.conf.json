{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipmo",
        "url": "index.html?mode=full",
        "width": 1040,
        "height": 680,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "focus": false,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "quick",
        "title": "Clipmo quick clipboard",
        "url": "index.html?mode=quick",
        "width": 560,
        "height": 620,
        "center": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "shortDescription": "Fast, private clipboard history for macOS",
    "longDescription": "Clipmo keeps text, links, images and files one shortcut away. Local clipboard history for Intel and Apple Silicon Macs, with no telemetry.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
