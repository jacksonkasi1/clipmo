{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipmo",
  "mainBinaryName": "clipmo",
  "version": "0.2.7",
  "identifier": "app.clipdeck.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Clipmo",
        "url": "index.html?mode=full",
        "width": 1040,
        "height": 680,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "focus": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visibleOnAllWorkspaces": false,
        "dragDropEnabled": true
      },
      {
        "label": "quick",
        "title": "Clipmo quick clipboard",
        "url": "index.html?mode=quick",
        "width": 560,
        "height": 620,
        "center": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Jackson Kasi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast, private clipboard history for Windows",
    "longDescription": "Clipmo keeps everything you copy — text, links, colors, images and files — and puts it one keystroke away. Native Windows 11 look, instant search, zero telemetry.",
    "copyright": "Copyright © 2026 Jackson Kasi",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  }
}
